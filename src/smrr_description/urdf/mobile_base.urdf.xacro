  <joint
    name="right_wheel_joint"
    type="continuous">
    <origin
      xyz="0 -0.201 0.0184000000000001"
      rpy="-1.5707963267949 0 0" />
    <parent
      link="base_link" />
    <child
      link="right_wheel" />
    <axis
      xyz="0 0 1" />
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link
    name="left_wheel">
    <inertial>
      <origin
        xyz="0 0 0"
