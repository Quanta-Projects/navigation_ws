<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_footprint"/>

  <joint
    name="base_joint"
    type="fixed">
    <origin
      xyz="0 0 0.0626"
      rpy="0 0 0" /> 
    <parent
      link="base_footprint" />
    <child
      link="base_link" />
  </joint>
  
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="0.0201310485852864 0.000520829416461865 0.35"
        rpy="0 0 0" />
      <mass
        value="10.0" />
      <inertia
        ixx="1.0"
        ixy="0.0"
        ixz="0.0"
        iyy="1.0"
        iyz="0.0"
        izz="0.8" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://smrr_description/meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.643137254901961 0.615686274509804 0.6 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://smrr_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link
    name="right_wheel">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="1.5" />
      <inertia
        ixx="0.0025"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0025"
        iyz="0.0"
        izz="0.0044" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <!-- <geometry>
        <mesh
          filename="package://smrr_description/meshes/right_wheel.STL" />
      </geometry> -->
       <geometry>
        <cylinder radius="0.081" length="0.05"/>
      </geometry>
      <material
        name="">
        <color
          rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <!-- <geometry>
        <mesh
          filename="package://smrr_description/meshes/right_wheel.STL" />
      </geometry> -->
       <geometry>
        <cylinder radius="0.081" length="0.05"/>
      </geometry>
    </collision>
  </link>

