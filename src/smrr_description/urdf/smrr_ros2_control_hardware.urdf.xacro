<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.14159265359" />
  <xacro:arg name="is_sim" default="false"/>
  <xacro:arg name="port" default="/dev/ttyACM0"/>


    <ros2_control name="RobotSystem" type="system">
        <!-- ros2_control Real Robot (Hardware Only - No Arm Joints) -->
        <hardware>
            <plugin>smrr_base_controller/BaseController</plugin>
            <param name="port">$(arg port)</param>  
            <!-- Port can be specified via launch file -->
        </hardware>

        <!-- Only wheel joints for differential drive -->
        <joint name="left_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

    </ros2_control> 

</robot>
