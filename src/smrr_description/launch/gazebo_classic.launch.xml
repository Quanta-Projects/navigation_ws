<launch>

  <!-- GPU env (same as your file) -->
  <!-- <set_env name="__NV_PRIME_RENDER_OFFLOAD" value="1"/>
  <set_env name="__GLX_VENDOR_LIBRARY_NAME" value="nvidia"/>
  <set_env name="__VK_LAYER_NV_optimus" value="NVIDIA_only"/>
  <set_env name="__EGL_VENDOR_LIBRARY_FILENAMES" value="/usr/share/glvnd/egl_vendor.d/10_nvidia.json"/> -->

  <!-- NEW: help Gazebo find installed models/resources -->
  <set_env name="GAZEBO_MODEL_PATH" value="$(find-pkg-prefix smrr_description)/share"/>

  <let name="urdf_path" 
        value="$(find-pkg-share smrr_description)/urdf/test.urdf.xacro" />

  <let name="rviz_config_path"
        value="$(find-pkg-share smrr_description)/config/urdf_config.rviz" />

  <!-- xacro → robot_description (pass is_sim just like Python) -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
  </node>

  <!-- Start Gazebo Classic -->
  <include file="$(find-pkg-share gazebo_ros)/launch/gazebo.launch.py" >
        <arg name="world" value="$(find-pkg-share gazebo_plugins)/model/moving_joint_model/level_simple.world"/>
    </include>  

  <!-- <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"/> -->

  <!-- Spawn entity from /robot_description with forced reset -->
  <node pkg="gazebo_ros" exec="spawn_entity.py" output="screen"
        args="-topic robot_description -entity smrr_fresh -x 0.0 -y -2.0 -z 0.1 -R 0.0 -P 0.0 -Y 0.0"/>

  <!-- Include existing joystick teleop -->
  <include file="$(find-pkg-share smrr_controller)/launch/joystick_teleop.launch.py"/>

  <!-- Optional: RViz -->
      <node pkg="rviz2" exec="rviz2" output="screen"
            args="-d $(var rviz_config_path)" />

      <!-- <node pkg="rviz2" exec="rviz2" output="screen" /> -->

</launch>
