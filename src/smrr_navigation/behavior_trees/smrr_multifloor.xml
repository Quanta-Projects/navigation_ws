<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="MissionTree">
  <BehaviorTree ID="MissionTree">
    <Fallback name="Root">
      <!-- Same-floor navigation -->
      <Sequence name="SameFloor">
        <IsSameFloor current_floor="{current_floor_id}" target_floor="{target_floor_id}"/>
        <NavigateToPose server_name="/navigate_to_pose" goal="{final_pose}"/>
      </Sequence>

      <!-- Cross-floor navigation -->
      <Sequence name="CrossFloor_ElevatorEntry">
        <IsDifferentFloor current_floor="{current_floor_id}" target_floor="{target_floor_id}"/>

        <!-- Navigate to staging pose on current floor -->
        <GetNamedPose locations_file="{locations_file}" floor_id="{current_floor_id}" location_key="elevator_staging" pose="{staging_pose}"/>
        <NavigateToPose server_name="/navigate_to_pose" goal="{staging_pose}"/>

        <!-- Keep tighter inflation while crossing elevator gap -->
        <SetCostmapInflation inflation_radius="0.325"/>

        <!-- Boost velocity before waiting: robot is already at gap-crossing speed the instant the door opens (zero-delay boost). -->
        <SetControllerParams max_vel_x="0.75"/>

        <!-- Resolve inside pose before the retry loop so it is available on the blackboard -->
        <GetNamedPose locations_file="{locations_file}" floor_id="{current_floor_id}" location_key="elevator_inside" pose="{inside_pose}"/>

        <!-- Elevator entry: call elevator, poll planner until door is open, then enter -->
        <RetryUntilSuccessful num_attempts="2" name="CallElevatorAndEnter_Twice">
          <Sequence name="CallWaitAndEnter">
            <!-- <CallElevator floor_id="{current_floor_id}"/> -->

            <!-- Planning-based door detection: poll global planner every 500 ms.
                 When the physical door opens the LiDAR clears the costmap obstacle
                 cells and ComputePathToPose succeeds, breaking out of the loop. -->
            <RetryUntilSuccessful num_attempts="3000" name="WaitForPath_Entry">
              <Delay delay_msec="500">
                <ComputePathToPose goal="{inside_pose}" path="{dummy_path}" planner_id="GridBased"/>
              </Delay>
            </RetryUntilSuccessful>

            <!-- Navigate inside elevator through entry waypoint, then to inside pose -->
            <GetNamedPose locations_file="{locations_file}" floor_id="{current_floor_id}" location_key="elevator_entry" pose="{entry_pose}"/>
            <GetNamedPose locations_file="{locations_file}" floor_id="{current_floor_id}" location_key="elevator_inside" pose="{inside_pose}"/>
            <BuildPoseVector pose1="{entry_pose}" pose2="{inside_pose}" poses="{entry_poses}"/>
            <NavigateThroughPoses server_name="/navigate_through_poses" goals="{entry_poses}"/>
          </Sequence>
        </RetryUntilSuccessful>

        <!-- Robot is confirmed inside the elevator from here — no retry wrapping below -->
        <StopRobot topic="/cmd_vel" repeat_ms="200" duration_ms="800"/>
        <Wait wait_duration="1.0"/>
        <!-- Turn on AprilTag detection for AMCL re-localization -->
        <ToggleAprilTag turn_on="true"/>
        <!-- Freeze AMCL particle filter during 180° spin to prevent bad updates -->
        <SetAMCLParams update_min_d="10.0" update_min_a="10.0"/>
        <!-- Rotate ~160° to face outward, ready for the exit door (physical robot calibrated value) -->
        <Spin spin_dist="-2.79253" time_allowance="20.0" is_recovery="true"/>

        <StopRobot topic="/cmd_vel" repeat_ms="200" duration_ms="800"/>
        <!-- Restore AMCL normal update thresholds (physical robot tuned values) -->
        <SetAMCLParams update_min_d="0.15" update_min_a="0.1"/>
        <!-- Mandatory minimum wait: robot is inside elevator so staging always unreachable;
             wait here before starting door-close detection to avoid false positive -->
        <Wait wait_duration="1.0"/>
        <!-- Wait for elevator door to fully close.
             Both entry_pose and staging_pose must be unreachable 200 ms apart
             to confirm the door is closed. A person blocking only one pose will
             not satisfy both checks simultaneously. -->
        <RetryUntilSuccessful num_attempts="3000" name="WaitForDoorClose">
          <Delay delay_msec="200">
            <Sequence name="ConfirmDoorClosed">
              <Inverter>
                <ComputePathToPose goal="{entry_pose}" path="{dummy_path}" planner_id="GridBased"/>
              </Inverter>
              <Delay delay_msec="200">
                <Inverter>
                  <ComputePathToPose goal="{staging_pose}" path="{dummy_path}" planner_id="GridBased"/>
                </Inverter>
              </Delay>
            </Sequence>
          </Delay>
        </RetryUntilSuccessful>
        <!-- Extra settle time after door closes before map switch -->
        <Wait wait_duration="3.0"/>

        <!-- Switch to target floor's open map while inside elevator -->
        <GetNamedMap locations_file="{locations_file}" floor_id="{target_floor_id}" map_key="open" map_yaml="{map_open_target}"/>
        <!-- Fetch both poses: target floor nominal pose AND departure floor expected pose -->
        <GetNamedPose locations_file="{locations_file}" floor_id="{target_floor_id}" location_key="amcl_initial_pose_open" pose="{amcl_open_target}"/>
        <GetNamedPose locations_file="{locations_file}" floor_id="{current_floor_id}" location_key="amcl_initial_pose_open" pose="{amcl_open_current}"/>
        <SwitchMap map_yaml="{map_open_target}"/>
        <!-- Publish initial pose with AprilTag TF correction for parking error (physical robot calibrated values) -->
        <PublishInitialPose initial_pose="{amcl_open_target}"
                            use_apriltag="true"
                            tag_frame="tag36h11:0"
                            base_frame="base_link"
                            expected_tag_x="0.591"
                            expected_tag_y="-0.169"
                            expected_tag_z="1.356"
                            expected_tag_roll="1.491"
                            expected_tag_pitch="0.015"
                            expected_tag_yaw="-1.502"/>
        <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
        <!-- Turn off AprilTag detection now that re-localization is complete -->
        <ToggleAprilTag turn_on="false"/>

        <!-- Exit elevator with retry mechanism -->
        <Fallback name="ExitElevator_WithRepositionRetry">

          <!-- Attempt 1: call elevator, poll planner until door open, exit -->
          <Sequence name="ExitAttempt_1">
            <!-- Resolve exit pose before the wait loop begins -->
            <GetNamedPose locations_file="{locations_file}" floor_id="{target_floor_id}" location_key="elevator_exit" pose="{exit_pose}"/>
            <!-- <CallElevator floor_id="{target_floor_id}"/> -->

            <CheckFloorArrival target_floor="{target_floor_id}"/>

            <!-- Boost velocity before waiting for exit door to open -->
            <SetControllerParams max_vel_x="0.75"/>

            <!-- Clear costmaps here: LiDAR re-contaminates them during CallElevator/CheckFloorArrival.
                 Must happen before the WaitForPath poll so the planner sees a clean costmap
                 and can detect the door opening via the obstacle layer clearing. -->
            <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>

            <RetryUntilSuccessful num_attempts="3000" name="WaitForPath_Exit1">
              <Delay delay_msec="500">
                <ComputePathToPose goal="{exit_pose}" path="{dummy_path}" planner_id="GridBased"/>
              </Delay>
            </RetryUntilSuccessful>

            <NavigateToPose server_name="/navigate_to_pose" goal="{exit_pose}"/>
            
          </Sequence>

          <!-- Attempt 2: reposition inside elevator, then retry -->
          <Sequence name="RepositionThenExitAttempt_2">
            <!-- Resolve exit pose before the wait loop begins -->
            <GetNamedPose locations_file="{locations_file}" floor_id="{target_floor_id}" location_key="elevator_exit" pose="{exit_pose}"/>
            <!-- Navigate to elevator inside pose of target floor to reposition -->
            <GetNamedPose locations_file="{locations_file}" floor_id="{target_floor_id}" location_key="elevator_inside" pose="{inside_pose}"/>
            <NavigateToPose server_name="/navigate_to_pose" goal="{inside_pose}"/>
            <Spin spin_dist="-2.79253" time_allowance="10.0" is_recovery="true"/>
            <StopRobot topic="/cmd_vel" repeat_ms="200" duration_ms="800"/>

            <!-- <CallElevator floor_id="{target_floor_id}"/> -->

            <CheckFloorArrival target_floor="{target_floor_id}"/>

            <!-- Boost velocity before waiting for exit door (retry attempt 2) -->
            <SetControllerParams max_vel_x="0.75"/>

            <!-- Clear costmaps before polling: same reason as ExitAttempt_1 -->
            <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>

            <RetryUntilSuccessful num_attempts="3000" name="WaitForPath_Exit2">
              <Delay delay_msec="500">
                <ComputePathToPose goal="{exit_pose}" path="{dummy_path}" planner_id="GridBased"/>
              </Delay>
            </RetryUntilSuccessful>

            <NavigateToPose server_name="/navigate_to_pose" goal="{exit_pose}"/>
            
          </Sequence>

        </Fallback>

        <!-- Reset velocity to normal after crossing the exit gap-->
        <SetControllerParams max_vel_x="0.5"/>

        <!-- Restore conservative inflation after exiting elevator -->
        <SetCostmapInflation inflation_radius="0.5"/>

        <!-- Navigate to final destination -->
        <NavigateToPose server_name="/navigate_to_pose" goal="{final_pose}"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>
</root>
