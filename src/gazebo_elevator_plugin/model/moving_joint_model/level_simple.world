<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Actor Ground Truth Plugin -->
    <plugin name="actor_pose_plugin" filename="libActorPosePlugin.so">
      <update_rate>10.0</update_rate>
    </plugin>

    <include>
      <uri>file:///home/achiraubuntu/navigation_ws/src/gazebo_elevator_plugin/model/multifloor_building</uri>
      <!-- <pose>0 -2.94 0 0 0 0</pose> -->
      <pose>0 -2.90 0 0 0 0</pose>
    </include>

    <include>
      <uri>file:///home/achiraubuntu/navigation_ws/src/gazebo_elevator_plugin/model/objects</uri>
      <!-- <pose>0 -2.94 0 0 0 0</pose> -->
      <pose>0 -2.90 0 0 0 0</pose>
    </include>

    <!-- Define the boxes and their joints -->
    <model name="sliding_boxes">
      <link name="level01_support">
        <pose>0 -0.055 2.7 0 0 0</pose>
        <visual name="support01_visual">
          <geometry>
            <box>
              <size>1.0 0.01 0.8</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <!-- <collision name="support01_collision">
          <geometry>
            <box>
              <size>1.0 0.01 0.95</size>
            </box>
          </geometry>
        </collision> -->
      </link>

      <link name="level02_support">
        <pose>0 -0.055 5.7 0 0 0</pose>
        <visual name="support02_visual">
          <geometry>
            <box>
              <size>1.0 0.01 0.8</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <!-- <collision name="support02_collision">
          <geometry>
            <box>
              <size>1.0 0.01 0.95</size>
            </box>
          </geometry>
        </collision> -->
      </link>

      <link name="level03_support">
        <pose>0 -0.055 8.7 0 0 0</pose>
        <visual name="support03_visual">
          <geometry>
            <box>
              <size>1.0 0.01 0.8</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <!-- <collision name="support03_collision">
          <geometry>
            <box>
              <size>1.0 0.01 0.95</size>
            </box>
          </geometry>
        </collision> -->
      </link>

      <link name="level04_support">
        <pose>0 -0.055 11.7 0 0 0</pose>
        <visual name="support04_visual">
          <geometry>
            <box>
              <size>1.0 0.01 0.8</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <collision name="support04_collision">
          <geometry>
            <box>
              <size>1.0 0.01 0.95</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="front_wall_right">
        <pose>1.5 -0.055 6 0 0 0</pose>
        <visual name="front_wall_right_visual">
          <geometry>
            <box>
              <size>2 0.01 12</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <collision name="front_wall_right_collision">
          <geometry>
            <box>
              <size>2 0.01 12</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="front_wall_left">
        <pose>-1.5 -0.055 6 0 0 0</pose>
        <visual name="front_wall_left_visual">
          <geometry>
            <box>
              <size>2 0.01 12</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <collision name="front_wall_left_collision">
          <geometry>
            <box>
              <size>2 0.01 12</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="base">
        <pose>0 0 0 0 0 0</pose>
      </link>

      <joint name="connector" type="fixed">
        <parent>base</parent>
        <child>Floor_6</child>
        <pose>0 0 0 0 0 0</pose>
      </joint>

      <joint name="joint_front_wall_left" type="fixed">
        <parent>level03_support</parent>
        <child>front_wall_left</child>
        <pose>0 0 0 0 0 0</pose>
      </joint>

      <joint name="joint_front_wall_right" type="fixed">
        <parent>level03_support</parent>
        <child>front_wall_right</child>
        <pose>0 0 0 0 0 0</pose>
      </joint>

      <joint name="joint_level01_support" type="fixed">
        <parent>base</parent>
        <child>level01_support</child>
        <pose>0 0 4.1 0 0 0</pose>
      </joint>

      <joint name="joint_level02_support" type="fixed">
        <parent>base</parent>
        <child>level02_support</child>
        <pose>0 0 7.1 0 0 0</pose>
      </joint>
      <joint name="joint_level03_support" type="fixed">
        <parent>base</parent>
        <child>level03_support</child>
        <pose>0 0 10.1 0 0 0</pose>
      </joint>
       <joint name="joint_level04_support" type="fixed">
        <parent>base</parent>
        <child>level04_support</child>
        <pose>0 0 13.1 0 0 0</pose>
      </joint>
    </model>

    <!-- The elevator car -->
    <model name="elevator">
      <pose>0.5 1.08 0.05 0 0 -1.5708</pose>
      <link name="link">
        <inertial>
          <mass>800</mass>
        </inertial>
  
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>2.25 2.25 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>2.25 2.25 0.1</size>
            </box>
          </geometry>
        </visual>
  
        <!-- wall1_collision is the wall to the right of the door, when
             facing the door -->
        <collision name="wall1_collision">
          <pose>1.0745 0.5725 1.125 0 0 0</pose> 
          <geometry>
            <box>
              <size>0.1 1.15 2.25</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall1_visual">
          <pose>1.0745 0.5725 1.125 0 0 0</pose> 
          <geometry>
            <box>
              <size>0.1 1.15 2.25</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
  
        <!-- wall2_collision is the wall to the left of the door, when
             facing the door -->
        <collision name="wall2_collision">
          <pose>1.0745 -1.0625 1.125 0 0 0</pose> 
          <geometry>
            <box>
              <size>0.1 0.125 2.25</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall2_visual">
          <pose>1.0745 -1.0625 1.125 0 0 0</pose> 
          <geometry>
            <box>
              <size>0.1 0.125 2.25</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <!-- Left wall -->
        <collision name="wall_left_collision">
          <pose>0 -1.075 0.5625 0 0 0</pose> 
          <geometry>
            <box>
              <size>2.25 0.1 1.125</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_left_visual">
          <pose>0 -1.075 0.5625 0 0 0</pose> 
          <geometry>
            <box>
              <size>2.25 0.1 1.125</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <!-- Right wall -->
        <collision name="wall_right_collision">
          <pose>0 1.075 0.5625 0 0 0</pose> 
          <geometry>
            <box>
              <size>2.25 0.1 1.125</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_right_visual">
          <pose>0 1.075 0.5625 0 0 0</pose> 
          <geometry>
            <box>
              <size>2.25 0.1 1.125</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <!-- Rear wall -->
        <collision name="wall_rear_collision">
          <pose>-1.075 0 0.5625 0 0 0</pose> 
          <geometry>
            <box>
              <size>0.1 2.25 1.125</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_rear_visual">
          <pose>-1.075 0 0.5625 0 0 0</pose> 
          <geometry>
            <box>
              <size>0.1 2.25 1.125</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
  
      <link name="door">
        <pose>1.0745 -0.5 1.125 0 0 0</pose> 
        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 1.0 2.25</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 1.0 2.25</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Black</name>
            </script>
          </material>
        </visual>
      </link>
    
      <joint name="door" type="prismatic">
        <parent>link</parent>
        <child>door</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>0</lower>
            <upper>1</upper>
            <effort>10</effort>
          </limit>

          <dynamics>
            <damping>2</damping>
          </dynamics>
        </axis>
      </joint>

      <joint name="lift" type="prismatic">
        <parent>world</parent>
        <child>link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>0</lower>
            <upper>10</upper>
            <effort>100000</effort>
          </limit>
  
          <dynamics>
            <damping>50</damping>
          </dynamics>
        </axis>
        <physics>
          <ode>
            <implicit_spring_damper>1</implicit_spring_damper>
          </ode>
        </physics>
      </joint>

      <!-- Plugin to control the elevator -->
      <plugin filename="libCustomElevatorPlugin.so" name="custom_elevator_plugin">
        <lift_joint>elevator::lift</lift_joint>
        <door_joint>elevator::door</door_joint>
        <floor_height>3.0</floor_height>
        <floor_offset>0.078</floor_offset>

        <!-- Time the elevator door will stay open in seconds -->
        <door_wait_time>100000</door_wait_time>

        <!-- This topic is used to control the elevator -->
        <topic>~/elevator</topic>
      </plugin>
    </model>

    <!-- Docking Station with AprilTag -->
    <model name='docking_station'>
      <static>1</static>
      <link name='docking_station_base_link'>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <collision name='docking_station_base_link_collision'>
          <pose>0 0 0 0 -0 0</pose>
          <geometry>
            <mesh>
              <scale>0.001 0.001 0.001</scale>
              <uri>file:///home/achiraubuntu/navigation_ws/src/smrr_description/meshes/Docking_station_assembly.STL</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='docking_station_base_link_visual'>
          <pose>0 0 0 0 -0 0</pose>
          <geometry>
            <mesh>
              <scale>0.001 0.001 0.001</scale>
              <uri>file:///home/achiraubuntu/navigation_ws/src/smrr_description/meshes/Docking_station_assembly.STL</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Grey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <visual name='apriltag_marker'>
          <pose>0.091 0.35 -0.018 0 0 1.5708</pose>
          <geometry>
            <box>
              <size>0.2 0.2 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <emissive>0.2 0.2 0.2 1</emissive>
            <lighting>1</lighting>
            <script>
              <uri>file:///home/achiraubuntu/navigation_ws/src/gazebo_elevator_plugin/model/Apriltag36_11_00000/materials/scripts</uri>
              <uri>file:///home/achiraubuntu/navigation_ws/src/gazebo_elevator_plugin/model/Apriltag36_11_00000/materials/textures</uri>
              <name>Apriltag36_11_00000</name>
            </script>
          </material>
        </visual>
      </link>
      <pose>4 -0.4 0.1 1.5708 0 0</pose>
    </model>

    <!-- Human Actors - Walking naturally in different areas of ground floor -->
    <!-- Actor 1: Left corridor area, back and forth -->
    <actor name="actor1">
      <skin>
        <filename>walk.dae</filename>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>-5.0 -1.8 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>7</time>
            <pose>-2.5 -1.8 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>10</time>
            <pose>-2.5 -1.3 0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>13</time>
            <pose>-4.0 -1.3 0 0 0 3.14</pose>
          </waypoint>
          <waypoint>
            <time>18</time>
            <pose>-5.0 -1.3 0 0 0 3.14</pose>
          </waypoint>
          <waypoint>
            <time>21</time>
            <pose>-5.0 -1.8 0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>28</time>
            <pose>-5.0 -1.8 0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Actor 2: Center area, L-shaped pattern -->
    <actor name="actor2">
      <skin>
        <filename>walk.dae</filename>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>0.5 -2.0 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>6</time>
            <pose>2.5 -2.0 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>9</time>
            <pose>2.5 -1.3 0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>13</time>
            <pose>1.0 -1.3 0 0 0 3.14</pose>
          </waypoint>
          <waypoint>
            <time>16</time>
            <pose>0.5 -2.0 0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>22</time>
            <pose>0.5 -2.0 0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Actor 3: Right side, circular-ish movement -->
    <actor name="actor3">
      <skin>
        <filename>walk.dae</filename>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>4.0 -1.6 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>6</time>
            <pose>5.5 -1.6 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>9</time>
            <pose>5.5 -1.3 0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>14</time>
            <pose>4.5 -1.3 0 0 0 3.14</pose>
          </waypoint>
          <waypoint>
            <time>17</time>
            <pose>4.0 -1.6 0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>20</time>
            <pose>4.0 -1.6 0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Actor 4: Far left, diagonal path -->
    <actor name="actor4">
      <skin>
        <filename>walk.dae</filename>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>-5.5 -1.5 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>9</time>
            <pose>-1.5 -1.5 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>12</time>
            <pose>-1.5 -1.9 0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>17</time>
            <pose>-4.5 -1.9 0 0 0 3.14</pose>
          </waypoint>
          <waypoint>
            <time>21</time>
            <pose>-5.5 -1.5 0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>30</time>
            <pose>-5.5 -1.5 0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Actor 5: Stationary standing person -->
    <actor name="actor5">
      <skin>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>0 -4.5 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>100</time>
            <pose>0 -4.5 0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Set the initial pose for the model -->
    <pose>0 0 0 0 0 0</pose>
  </world>
</sdf> 
